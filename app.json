{
  "expo": {
    "name": "Quest",
    "icon": "./assets/images/quest-icon.png",
    "slug": "chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aion.chat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quest-adaptive-foreground.png",
        "backgroundColor": "#FFFCF5"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quest-adaptive-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-system-ui",
      "expo-status-bar",
      ["expo-image-picker", { "cameraPermission": "允许 Quest 拍摄照片并添加到当前对话。", "photosPermission": "允许 Quest 选择照片并添加到当前对话。", "microphonePermission": false }],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
