# Phase 1: use the existing mock stream without a backend or API key.
EXPO_PUBLIC_MOCK_AI=1
# Only needed for the existing server-side API route when mock mode is off.
# ANTHROPIC_API_KEY=
# Optional full HTTPS endpoint for a separately authenticated model backend.
# In development, the native client otherwise uses the Metro host's /api/chat.
# The bundled production API stays disabled until real authentication is added.
# EXPO_PUBLIC_API_URL=https://your-server.example/api/chat
EXPO_UNSTABLE_DEPLOY_SERVER=1
